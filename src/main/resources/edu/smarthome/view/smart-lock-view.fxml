<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.smarthome.controller.SmartLockController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="CERRADURA INTELIGENTE"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label fx:id="stateLabel"
           text="Estado: --"
           style="-fx-font-size: 16px;"/>

    <Label fx:id="attemptsLabel"
           text="Intentos fallidos: 0 / 3"
           style="-fx-font-size: 14px;"/>

    <VBox spacing="10" alignment="CENTER">
        <PasswordField fx:id="pinField"
                       promptText="Ingrese PIN"
                       prefWidth="150"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Desbloquear"
                    onAction="#onUnlockClick"/>

            <Button text="Bloquear"
                    onAction="#onLockClick"/>
        </HBox>
    </VBox>

    <Label text="Gestión de PINs"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="10" alignment="CENTER">
        <TextField fx:id="userField"
                   promptText="Nombre de usuario"
                   prefWidth="180"/>

        <PasswordField fx:id="newPinField"
                       promptText="Nuevo PIN (4-8 dígitos)"
                       prefWidth="180"/>

        <Button text="Agregar PIN"
                onAction="#onAddPinClick"/>
    </VBox>

    <Label fx:id="statusLabel"
           text="Sistema listo"
           style="-fx-font-size: 14px;"/>

</VBox>