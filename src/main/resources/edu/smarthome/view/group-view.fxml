<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      prefWidth="420"
      prefHeight="580"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.smarthome.controller.GroupController">

    <padding>
        <Insets top="35" right="40" bottom="35" left="40"/>
    </padding>

    <Label text="GRUPOS"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="Control del grupo Casa"
           style="-fx-font-size: 17px;"/>

    <Label text="Casa"
           style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

    <HBox spacing="15" alignment="CENTER">

        <Button text="Activar"
                onAction="#onPowerOnClick"
                prefWidth="110"
                prefHeight="34"/>

        <Button text="Desactivar"
                onAction="#onPowerOffClick"
                prefWidth="110"
                prefHeight="34"/>

    </HBox>

    <VBox alignment="CENTER" spacing="10">

        <Label text="Temperatura del grupo"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <TextField fx:id="temperatureField"
                   promptText="Temperatura"
                   prefWidth="240"
                   prefHeight="34"/>

        <Button text="Aplicar temperatura"
                onAction="#onSetTemperatureClick"
                prefWidth="180"
                prefHeight="34"/>

    </VBox>

    <VBox alignment="CENTER" spacing="10">

        <Label text="Modo climático"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <HBox spacing="12" alignment="CENTER">

            <Button text="Comfort"
                    onAction="#onComfortClick"
                    prefWidth="90"
                    prefHeight="34"/>

            <Button text="Eco"
                    onAction="#onEcoClick"
                    prefWidth="90"
                    prefHeight="34"/>

            <Button text="Night"
                    onAction="#onNightClick"
                    prefWidth="90"
                    prefHeight="34"/>

        </HBox>

    </VBox>

    <Button text="Bloquear grupo"
            onAction="#onLockGroupClick"
            prefWidth="160"
            prefHeight="34"/>

    <Label fx:id="statusLabel"
           text="Sistema listo"
           style="-fx-font-size: 15px;"/>

</VBox>