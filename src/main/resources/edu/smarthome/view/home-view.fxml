<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.smarthome.controller.HomeController">

    <padding>
        <Insets top="25" right="35" bottom="25" left="35"/>
    </padding>

    <Label text="SMART HOME"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Sistema de hogar inteligente"
           style="-fx-font-size: 16px;"/>

    <VBox alignment="CENTER" spacing="8">

        <Label text="Dispositivos"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button text="Luces"
                    onAction="#onLightsClick"
                    prefWidth="110"/>

            <Button text="Termostato"
                    onAction="#onThermostatClick"
                    prefWidth="110"/>

            <Button text="Cerradura"
                    onAction="#onSmartLockClick"
                    prefWidth="110"/>
        </HBox>

    </VBox>

    <VBox alignment="CENTER" spacing="8">

        <Label text="Grupos"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Button text="Grupos"
                onAction="#onGroupsClick"
                prefWidth="150"/>

    </VBox>

    <VBox alignment="CENTER" spacing="8">

        <Label text="Seguridad"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button text="Desbloquear casa"
                    onAction="#onUnlockHomeClick"
                    prefWidth="140"/>

            <Button text="Bloquear casa"
                    onAction="#onLockHomeClick"
                    prefWidth="140"/>
        </HBox>

    </VBox>

    <Label fx:id="statusLabel"
           text="Sistema listo"
           style="-fx-font-size: 14px;"/>

</VBox>