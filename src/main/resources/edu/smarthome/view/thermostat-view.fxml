<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.smarthome.controller.ThermostatController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="TERMOSTATO"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label fx:id="currentTemperatureLabel"
           text="Temperatura actual: -- °C"
           style="-fx-font-size: 16px;"/>

    <Label fx:id="targetTemperatureLabel"
           text="Temperatura objetivo: -- °C"
           style="-fx-font-size: 16px;"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="temperatureField"
                   promptText="Temperatura"
                   prefWidth="120"/>

        <Button text="Aplicar"
                onAction="#onSetTemperatureClick"/>
    </HBox>

    <Label text="Modo climático"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Comfort"
                onAction="#onComfortClick"/>

        <Button text="Eco"
                onAction="#onEcoClick"/>

        <Button text="Night"
                onAction="#onNightClick"/>
    </HBox>

    <Label fx:id="modeLabel"
           text="Modo: --"
           style="-fx-font-size: 14px;"/>

    <Label fx:id="statusLabel"
           text="Sistema listo"
           style="-fx-font-size: 14px;"/>

</VBox>